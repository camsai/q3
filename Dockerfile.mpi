# Q3 — MPI image, for multi-rank runs on a cluster.
#
# Everything here that is not in the serial Dockerfile exists for one reason:
# the host's MPI has to replace the container's at run time. `podman-hpc --mpi`
# and Shifter's `--module=mpich` both work by binding the host's MPICH over the
# container's libmpi, which only links if the container was built against an
# ABI-compatible MPICH. A distribution package does not qualify -- Ubuntu's
# libmpich-dev is configured for the distribution, and Ubuntu's OpenMPI has a
# different ABI altogether -- so MPICH is built from source here, and FFTW is
# rebuilt on top of it because an MPI-enabled FFTW must match the MPI it will
# be loaded beside.
#
# The image still runs standalone with its own MPICH when no host MPI is
# injected, which is what the CI smoke test exercises.

ARG MPICH_VERSION=4.2.3
ARG FFTW_VERSION=3.3.10

# ---------- Stage 1: build ----------
FROM ubuntu:24.04 AS builder

ARG MPICH_VERSION
ARG FFTW_VERSION
ENV DEBIAN_FRONTEND=noninteractive

# libfftw3-dev is deliberately absent: FFTW is built from source below, and a
# distribution copy on the default search path would win the find_library()
# probe and silently give the serial build back.
#
# OpenBLAS for the same reason the serial Dockerfile gives: the reference
# netlib BLAS that the unqualified -dev names resolve to is untuned and
# single-threaded, and it cost the published images a factor of ten serial and
# forty threaded (camsai/q3#12).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libopenblas-dev \
        libxc-dev \
        libomp-dev \
        python3 \
        python3-venv \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# MPICH, from source. ch4:ofi is the device NERSC's own container examples
# build against. Fortran is off because nothing in this image needs it: Q3
# links MPI::MPI_CXX, and ScaLAPACK -- the one Fortran consumer -- is not
# included (see the note in the runtime stage).
#
# --disable-fortran is load-bearing rather than cosmetic, so it is worth
# stating what it requires of the C++: an MPI built this way never initializes
# the Fortran predefined datatypes, and passing one to a collective aborts the
# job. Q3 passed MPI_DOUBLE_COMPLEX -- Fortran's -- for std::complex<double>
# until 2026-09-11, so every published -mpi image aborted the moment two ranks
# shared a k-point pool (camsai/q3#11). The C++ datatypes are always present;
# see src/layer_0_core/execution/mpi_datatype.hpp, and the rank-sharing case in
# container.yml that now runs here.
RUN curl -fsSL "https://www.mpich.org/static/downloads/${MPICH_VERSION}/mpich-${MPICH_VERSION}.tar.gz" \
        | tar -xz -C /tmp \
    && cd "/tmp/mpich-${MPICH_VERSION}" \
    && ./configure \
        --prefix=/opt/mpich \
        --with-device=ch4:ofi \
        --disable-fortran \
        --enable-shared \
        --disable-static \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf "/tmp/mpich-${MPICH_VERSION}"

ENV PATH=/opt/mpich/bin:$PATH

# FFTW, against that MPICH. Three libraries come out of one build and Q3 looks
# for all three: libfftw3 (always), libfftw3_threads (Q3_WITH_FFTW_THREADS,
# on by default), and libfftw3_mpi. Without the last one q3_mpi still builds
# and still parallelizes over k-point pools, but band groups larger than one
# rank are refused at run time -- see the FFTW3 MPI section of CMakeLists.txt.
#
# The SIMD flags are not optional. FFTW's configure enables no SIMD codelets by
# default, so the library this step first produced held scalar code only: no
# AVX instruction on x86_64, against 54,420 in Ubuntu's libfftw3, which the
# serial and CUDA images use. Every rank of a k-point-pool run paid 1.3-1.5x on
# its FFTs against a native Perlmutter build (camsai/q3#20). FFTW picks codelets
# at plan time from the CPU it runs on, so AVX2 codelets do not stop the image
# from running on an older x86_64 host. Double-precision NEON needs AArch64,
# which the arm64 build is.
#
# The check after the install fails the build if the codelets go missing
# again: scalar x86_64 code never touches a ymm register, and on arm64 the NEON
# codelets are named symbols (207 of them for FFTW 3.3.10).
RUN case "$(uname -m)" in \
        x86_64)  simd="--enable-sse2 --enable-avx --enable-avx2" ;; \
        aarch64) simd="--enable-neon" ;; \
        *)       simd="" ;; \
    esac \
    && curl -fsSL "https://www.fftw.org/fftw-${FFTW_VERSION}.tar.gz" | tar -xz -C /tmp \
    && cd "/tmp/fftw-${FFTW_VERSION}" \
    && ./configure \
        --prefix=/opt/fftw \
        --enable-shared \
        --disable-static \
        --enable-threads \
        --enable-mpi \
        $simd \
        MPICC=/opt/mpich/bin/mpicc \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf "/tmp/fftw-${FFTW_VERSION}" \
    && case "$(uname -m)" in \
        x86_64) \
            avx_instructions="$(objdump -d /opt/fftw/lib/libfftw3.so | grep -c ymm || true)"; \
            echo "libfftw3: ${avx_instructions} instructions on ymm registers"; \
            test "${avx_instructions}" -gt 0 ;; \
        aarch64) \
            neon_codelets="$(nm -D /opt/fftw/lib/libfftw3.so | grep -c '_neon$' || true)"; \
            echo "libfftw3: ${neon_codelets} NEON codelets"; \
            test "${neon_codelets}" -gt 0 ;; \
    esac

WORKDIR /opt/q3-src
COPY . /opt/q3-src

# Same reasoning as the serial image: the venv must be at ${CMAKE_SOURCE_DIR}/.venv
# for CMakeLists.txt to find it, and it must exist before `cmake --build`,
# which is when the schema-to-C++ generator runs.
RUN python3 -m venv /opt/q3-src/.venv \
    && /opt/q3-src/.venv/bin/pip install --no-cache-dir pyyaml jinja2 jsonref

# FFTW_ROOT is read by CMakeLists.txt's own hint list, which is how the
# source-built FFTW is found ahead of anything else. find_package(MPI) picks
# up the source-built MPICH from PATH.
ENV FFTW_ROOT=/opt/fftw
# The commit this image was built from, stamped into q3 --version and every
# results.json. .dockerignore drops .git/ from the build context (see there),
# so the SHA has to be handed in; an empty value is the honest default and
# reports "commit unknown", which is what every published image said before
# the workflow started passing it (camsai/q3#6).
ARG Q3_GIT_COMMIT=""
RUN cmake -S . -B build \
        -DQ3_BUILD_TESTS=OFF \
        -DQ3_WITH_MPI=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/q3 \
        -DQ3_GIT_COMMIT="${Q3_GIT_COMMIT}" \
    && cmake --build build -j"$(nproc)" \
    && cmake --install build

# ---------- Stage 2: runtime ----------
FROM ubuntu:24.04

LABEL org.opencontainers.image.title="Q3 (MPI)" \
      org.opencontainers.image.description="Q3 DFT engine with MPI k-point pool and band-group parallelism" \
      org.opencontainers.image.vendor="Mat3ra" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV DEBIAN_FRONTEND=noninteractive

# No libfftw3-double3 here, unlike the serial image: FFTW comes from /opt/fftw
# below. Everything else is the same runtime set.
#
# ScaLAPACK is absent on purpose. The distribution builds link the
# distribution's MPI, which is the ABI this image exists to avoid, and
# building it from source would pull the Fortran toolchain back in for a
# component CMakeLists.txt treats as optional. Without it the parallel
# subspace diagonalization falls back to a redundant serial solve, which CI
# already covers as a supported configuration in ci.yml's `without` leg.
# The -openmp OpenBLAS runtime, as in the serial image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopenblas0-openmp \
        libxc9 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/mpich /opt/mpich
COPY --from=builder /opt/fftw /opt/fftw
# Whatever cmake installed, under whatever names. Enumerating the binaries
# here couples this file to names that change -- q3-convert is folding into a
# `q3_utility convert` subcommand -- and installing to a private prefix rather
# than /usr/local means only Q3's own binaries are in the directory to copy,
# whatever base image the builder used.
COPY --from=builder /opt/q3/bin/ /usr/local/bin/

ENV PATH=/opt/mpich/bin:/usr/local/bin:$PATH \
    LD_LIBRARY_PATH=/opt/mpich/lib:/opt/fftw/lib \
    OMP_NUM_THREADS=1

# A missing runtime library is a wrong copy above, and it must fail the build
# rather than the user's first job on a compute node. `q3_mpi` itself is left
# to the CI smoke test, which runs it under a launcher across several rank
# counts: starting it here as a singleton would test MPICH's singleton-init
# path rather than anything about this image.
RUN if ldd /usr/local/bin/* | grep 'not found'; then exit 1; fi \
    && q3 --version > /dev/null \
    && mpiexec --version > /dev/null

# The serial binary, so `podman-hpc run <image> q3 input.yml` behaves the same
# way as with the plain image. Reach the parallel one by name, under the
# launcher: `mpiexec -n 4 q3_mpi input.yml`, or `srun ... q3_mpi input.yml`
# once the host MPI has been swapped in.
CMD ["q3"]
