# Q3 — CUDA image, for NVIDIA GPUs.
#
# Unlike the serial and MPI images this one is amd64 only, and deliberately so:
# the GPUs this targets sit in x86_64 nodes, and there is no arm64 GPU runner
# to build or test an aarch64 copy on. Publishing an untested one under a
# multi-architecture tag would be worse than not publishing it.
#
# Pinned to the OLDEST toolkit the image needs to serve, not the newest
# available, because the compatibility only runs one way. The container ships
# the CUDA runtime but not the driver, which comes from the host, so the host
# driver decides what the image can do:
#
#   CUDA 12.x needs driver >= 525          CUDA 13.x needs driver >= 580
#
# An application built against an older toolkit keeps working on newer drivers
# -- that is binary backward compatibility, and it is guaranteed. The reverse is
# not: a 13.x build on a pre-580 driver fails at the first CUDA call unless the
# host installs a forward-compatibility package, which is an extra step and is
# restricted by platform and GPU.
#
# So 12.8 runs everywhere 13.1 would AND on the 12.x hosts 13.1 would refuse,
# while costing nothing in return: it supports every architecture named below,
# and Q3's GPU backend uses only long-standing cudart, cuBLAS, cuSOLVER and
# cuFFT entry points. Raise this only when something needs a 13.x feature, and
# check the driver floor on the machines that will run it first.
#
# .github/workflows/cuda.yml installs this same version on the self-hosted GPU
# runner, so the CPU/GPU parity check that gates the backend exercises the
# toolkit this image ships rather than a build nobody runs. The two are a pair:
# change them together, or the gate stops covering the artefact.
ARG CUDA_VERSION=12.8.1

# Which GPUs the compiled kernels will run on. 80 is the A100, 90 the H100;
# CMakeLists.txt defaults to 80 alone, and this widens it because a published
# image cannot know which of the two it will land on. An explicit value here
# also stops the build from silently taking that default if it ever changes.
ARG CUDA_ARCHITECTURES="80;90"

# Ubuntu's FFTW, pinned for the reason the serial Dockerfile gives: the GPL
# source container.yml publishes must be this exact build. The CUDA image's
# combination with NVIDIA's runtime is under counsel review (TODOs.md §3.2).
ARG FFTW_UBUNTU_VERSION=3.3.10-1ubuntu3

# ---------- Stage 1: build ----------
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04 AS builder

ARG CUDA_ARCHITECTURES
ARG FFTW_UBUNTU_VERSION
ENV DEBIAN_FRONTEND=noninteractive

# OpenBLAS for the same reason the serial Dockerfile gives: the reference
# netlib BLAS that the unqualified -dev names resolve to is untuned and
# single-threaded, and it cost the published images a factor of ten serial and
# forty threaded (camsai/q3#12).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libfftw3-dev=${FFTW_UBUNTU_VERSION} \
        libopenblas-dev \
        libxc-dev \
        libomp-dev \
        python3 \
        python3-venv \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/q3-src
COPY . /opt/q3-src

RUN python3 -m venv /opt/q3-src/.venv \
    && /opt/q3-src/.venv/bin/pip install --no-cache-dir pyyaml jinja2 jsonref

# One engine binary ships: the CUDA build, installed as q3 with q3_gpu_cuda as a
# symlink to it, so the image is invoked like every other one (#316). The
# serial reference the CPU/GPU parity check compares against is the plain
# image, or a serial build tree beside the CUDA one, as cuda.yml does.
# The commit this image was built from, stamped into q3 --version and every
# results.json. .dockerignore drops .git/ from the build context (see there),
# so the SHA has to be handed in; an empty value is the honest default and
# reports "commit unknown", which is what every published image said before
# the workflow started passing it (camsai/q3#6).
ARG Q3_GIT_COMMIT=""
RUN cmake -S . -B build \
        -DQ3_BUILD_TESTS=OFF \
        -DQ3_WITH_CUDA=ON \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/q3 \
        -DQ3_GIT_COMMIT="${Q3_GIT_COMMIT}" \
    && cmake --build build -j"$(nproc)" \
    && cmake --install build

# The license file of each FetchContent dependency compiled into the binaries,
# for the runtime stage's license directory (THIRD_PARTY_NOTICES.md).
RUN for source in build/_deps/*-src; do \
        target="/opt/q3-licenses/$(basename "$source" -src)"; \
        mkdir -p "$target" \
        && find "$source" -maxdepth 1 -type f \( -iname 'licen[cs]e*' -o -iname 'copying*' \) \
            -exec cp {} "$target" \; \
        && test -n "$(ls -A "$target")" || { echo "no license file in $source" >&2; exit 1; }; \
    done

# ---------- Stage 2: runtime ----------
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu24.04

LABEL org.opencontainers.image.title="Q3 (CUDA)" \
      org.opencontainers.image.description="Q3 DFT engine with the NVIDIA CUDA GPU backend" \
      org.opencontainers.image.vendor="Mat3ra" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      q3.license.notice="This image is a combined work including FFTW and is distributed under GPL-3.0-or-later as a whole; Q3's own source is Apache-2.0."

ARG FFTW_UBUNTU_VERSION
ENV DEBIAN_FRONTEND=noninteractive

# OpenBLAS matters here for the CPU-side stages; the GPU path already goes
# through cuBLAS.
#
# The CUDA runtime image already carries cudart, cuBLAS, cuSOLVER and cuFFT,
# which is the whole reason for basing on it rather than adding them here.
# What it does not carry is the driver: libcuda.so.1 comes from the host, put
# in place by the container runtime's GPU support (`podman-hpc --gpu`,
# `docker run --gpus`). Nothing links it directly -- CUDA::cudart loads it on
# the first CUDA call -- so the check below stays clean in a machine with no
# GPU, and a missing driver surfaces at run time as a CUDA error rather than
# as a link failure.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libfftw3-double3=${FFTW_UBUNTU_VERSION} \
        libopenblas0-openmp \
        libxc9 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Whatever cmake installed, under whatever names. Enumerating the binaries
# here couples this file to names that change -- q3-convert is folding into a
# `q3_utility convert` subcommand -- and installing to a private prefix rather
# than /usr/local means only Q3's own binaries are in the directory to copy,
# whatever base image the builder used.
COPY --from=builder /opt/q3/bin/ /usr/local/bin/

ENV PATH=/usr/local/bin:$PATH \
    OMP_NUM_THREADS=1

RUN if ldd /usr/local/bin/* | grep 'not found'; then exit 1; fi \
    && q3 --version > /dev/null

# Notices, license texts and the written offer, as in Dockerfile. NVIDIA's
# license for the CUDA libraries is the base image's /NGC-DL-CONTAINER-LICENSE.
COPY LICENSE.md THIRD_PARTY_NOTICES.md /usr/share/licenses/q3/
COPY --from=builder /opt/q3-licenses/ /usr/share/licenses/q3/
ARG Q3_SOURCE_BUNDLE_URL=""
ARG Q3_SOURCE_BUNDLE_SHA256=""
RUN printf '\n## This image\n\n-   Complete corresponding source: %s\n-   SHA-256: %s\n' \
        "${Q3_SOURCE_BUNDLE_URL:-none, not a published build}" "${Q3_SOURCE_BUNDLE_SHA256:-none}" \
        >> /usr/share/licenses/q3/THIRD_PARTY_NOTICES.md
LABEL q3.source-bundle.url="${Q3_SOURCE_BUNDLE_URL}" \
      q3.source-bundle.sha256="${Q3_SOURCE_BUNDLE_SHA256}"

# q3 is the CUDA build here: `podman-hpc run --gpu <image> q3 input.yml`.
# q3_gpu_cuda is a symlink to it, for scripts that still use that name.
CMD ["q3"]
