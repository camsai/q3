&CONTROL
  calculation = 'scf'
  pseudo_dir = '../../../../examples/data/pseudopotentials/nc/'
  outdir = './tmp_reduced'
  prefix = 'triclinic_reduced'
  tstress = .true.
  tprnfor = .true.
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 60.0
  ecutrho = 240.0
  nbnd = 8
  input_dft = 'XC-000I-000I-101L-130L'
/
&ELECTRONS
  conv_thr = 1.0d-12
  electron_maxstep = 200
  mixing_beta = 0.3
  mixing_mode = 'plain'
/
ATOMIC_SPECIES
  Si 28.0855 Si.upf
ATOMIC_POSITIONS crystal
  Si 0.11 0.18 0.27
  Si 0.47 0.56 0.68
CELL_PARAMETERS angstrom
  5.1 0.1 0.2
  0.7 4.8 0.3
  0.4 0.9 5.3
K_POINTS automatic
  2 2 2 1 1 1
