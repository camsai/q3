&CONTROL
  calculation = 'scf'
  pseudo_dir = '../../../data/pseudopotentials/nc/'
  outdir = './tmp'
  prefix = 'silicon_atom'
  verbosity = 'high'
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 1
  celldm(1) = 15.117809
  nat = 1
  ntyp = 1
  ecutwfc = 48.0
  ecutrho = 192.0
  nbnd = 4
  tot_charge = 3.0
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.01
  input_dft = 'XC-000I-000I-101L-130L'
/
&ELECTRONS
  conv_thr = 1.0e-12
  mixing_beta = 0.3
  mixing_mode = 'plain'
/
ATOMIC_SPECIES
  Si  28.0855  Si.upf
ATOMIC_POSITIONS crystal
  Si  0.5  0.5  0.5
K_POINTS automatic
  1 1 1  0 0 0
