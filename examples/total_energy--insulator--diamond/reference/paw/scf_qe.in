&CONTROL
  calculation = 'scf'
  pseudo_dir = '../../../data/pseudopotentials/paw/'
  outdir = './tmp'
  prefix = 'qe_paw'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 2
  celldm(1) = 6.740000000000000
  nat = 2
  ntyp = 1
  ecutwfc = 60.0
  ecutrho = 480.0
  input_dft = 'XC-000I-000I-101L-130L'
/
&ELECTRONS
  diagonalization = 'cg'
  conv_thr = 1.0e-8
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  C 12.011 C.upf
ATOMIC_POSITIONS crystal
  C 0.000000 0.000000 0.000000
  C 0.250000 0.250000 0.250000
K_POINTS automatic
  4 4 4 0 0 0
