&control
    calculation = 'bands',
    outdir = './qe_output',
    prefix = 'si_scf',
    pseudo_dir = '.',
/
&system
    ibrav = 2,
    celldm(1) = 10.3344,
    nat = 2,
    ntyp = 1,
    ecutwfc = 48.0,
    ecutrho = 192.0,
    nbnd = 12,
    input_dft = 'XC-000I-000I-101L-130L',
/
&electrons
    conv_thr = 1.0e-8,
/
ATOMIC_SPECIES
  Si  28.0855  Si.upf

ATOMIC_POSITIONS crystal
  Si  0.875  0.875  0.875
  Si  0.125  0.125  0.125

K_POINTS crystal_b
6
  0.000  0.000  0.000  30  ! G
  0.500  0.000  0.500  30  ! X
  0.500  0.250  0.750  30  ! W
  0.375  0.375  0.750  30  ! K
  0.000  0.000  0.000  30  ! G
  0.500  0.500  0.500  1   ! L
