&control
    calculation = 'scf',
    outdir = './qe_output',
    prefix = 'si_scf',
    pseudo_dir = '.',
    tprnfor = .true.,
    tstress = .true.,
/
&system
    ibrav = 2,
    celldm(1) = 10.3344,
    nat = 2,
    ntyp = 1,
    ecutwfc = 48.0,
    ecutrho = 192.0,
    input_dft = 'XC-000I-000I-101L-130L',
/
&electrons
    conv_thr = 1.0e-8,
    mixing_mode = 'plain',
    mixing_beta = 0.7,
/
ATOMIC_SPECIES
  Si  28.0855  Si.upf

ATOMIC_POSITIONS crystal
  Si  0.875  0.875  0.875
  Si  0.125  0.125  0.125

K_POINTS automatic
  4 4 4  0 0 0
