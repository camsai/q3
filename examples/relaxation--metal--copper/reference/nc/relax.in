&control
    calculation = 'relax',
    outdir = './qe_output',
    prefix = 'cu_nc_relax',
    pseudo_dir = '../../../data/pseudopotentials/nc',
    tprnfor = .true.,
    tstress = .true.,
    forc_conv_thr = 5.0e-3,
/
&system
    ibrav = 2,
    celldm(1) = 6.8432,
    nat = 1,
    ntyp = 1,
    ecutwfc = 120.0,
    ecutrho = 480.0,
    occupations = 'smearing',
    smearing = 'gaussian',
    degauss = 0.02,
    input_dft = 'XC-000I-000I-101L-130L',
/
&electrons
    conv_thr = 1.0e-6,
    mixing_mode = 'plain',
    mixing_beta = 0.1,
/
&ions
    ion_dynamics = 'bfgs',
/
ATOMIC_SPECIES
  Cu  63.546  Cu.upf

ATOMIC_POSITIONS crystal
  Cu  0.0  0.0  0.0

K_POINTS automatic
  4 4 4  1 1 1
