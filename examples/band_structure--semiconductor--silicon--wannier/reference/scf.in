&control
    calculation = 'scf',
    outdir = './qe_output',
    prefix = 'si_wannier',
    pseudo_dir = '.',
/
&system
    ibrav = 2,
    celldm(1) = 10.3344,   ! matches examples/data/materials/silicon.json
                           ! (primitive |a| 3.866976 Ang -> cubic a 5.46873 Ang)
    nat = 2,
    ntyp = 1,
    ecutwfc = 48.0,
    ecutrho = 192.0,
/
&electrons
    conv_thr = 1.0e-10,
    mixing_mode = 'plain',
    mixing_beta = 0.7,
/
ATOMIC_SPECIES
  Si  28.0855  Si.upf

ATOMIC_POSITIONS crystal
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25

K_POINTS automatic
  4 4 4  0 0 0
