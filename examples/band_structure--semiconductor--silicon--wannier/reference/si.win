num_wann = 4
num_bands = 4

! Isolated valence manifold: Si has 8 valence electrons, so bands
! 1-4 are the occupied sp3 bonding manifold and are separated from
! the conduction bands everywhere. No disentanglement needed, which
! is what makes Omega_I from raw M a clean cross-code comparison.

! Bond-centred s orbitals at the four Si-Si bond midpoints. Silicon's
! valence Wannier functions ARE bond-centred, so this guess is far closer
! to the localized solution than atom-centred sp3 hybrids: measured band
! distance against QE's direct bands on this 4x4x4 grid drops from 106 meV
! to 68 meV purely by moving the trial orbitals here. The four midpoints
! are half-way to the four tetrahedral neighbours of the atom at the
! origin, each at sqrt(3)/8 of the lattice parameter.
!
! zona = 1.0 matches the 1 bohr decay nc_nscf.yml gives Q3's hydrogenic
! orbitals, so both chains describe the same four orbitals. The Wannier90
! user guide states zona in reciprocal Angstrom, but pw2wannier90 hands it
! unconverted to its radial transform against |k+G| in inverse bohr
! (PP/src/pw2wannier90.f90: generate_guiding_functions, radialpart), so the
! value that matches is 1.0 and not 1.89 -- confirmed by the agreement of
! the two chains' interpolations (0.6 meV rms at 1.0, 3.7 meV at 1.89).
begin projections
f=0.125,0.125,0.125:s:zona=1.0
f=0.125,0.125,-0.375:s:zona=1.0
f=-0.375,0.125,0.125:s:zona=1.0
f=0.125,-0.375,0.125:s:zona=1.0
end projections

begin unit_cell_cart
bohr
  -5.1672   0.0000   5.1672
   0.0000   5.1672   5.1672
  -5.1672   5.1672   0.0000
end unit_cell_cart

begin atoms_frac
Si  0.00  0.00  0.00
Si  0.25  0.25  0.25
end atoms_frac

mp_grid = 4 4 4

