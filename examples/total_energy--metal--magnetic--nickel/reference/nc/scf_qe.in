&CONTROL
  calculation = 'scf'
  pseudo_dir = '../../../data/pseudopotentials/nc/'
  outdir = './tmp'
  prefix = 'ni_nc'
  verbosity = 'high'
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 2
  celldm(1) = 6.625
  nat = 1
  ntyp = 1
  ecutwfc = 60.0
  ecutrho = 240.0
  nspin = 2
  starting_magnetization(1) = 0.3
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.02
  input_dft = 'XC-000I-000I-101L-130L'
/
&ELECTRONS
  conv_thr = 1.0e-8
  mixing_beta = 0.1
  mixing_mode = 'plain'
/
ATOMIC_SPECIES
  Ni  58.6934  Ni.upf
ATOMIC_POSITIONS crystal
  Ni  0.0  0.0  0.0
K_POINTS automatic
  12 12 12  1 1 1
