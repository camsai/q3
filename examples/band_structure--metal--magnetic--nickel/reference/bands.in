&control
    calculation = 'bands',
    outdir = './qe_output',
    prefix = 'ni_bands',
    pseudo_dir = '../../data/pseudopotentials/nc',
/
&system
    ibrav = 2,
    celldm(1) = 6.625,
    nat = 1,
    ntyp = 1,
    ecutwfc = 60.0,
    ecutrho = 240.0,
    nbnd = 16,
    nspin = 2,
    starting_magnetization(1) = 0.3,
    occupations = 'smearing',
    smearing = 'gaussian',
    degauss = 0.02,
    input_dft = 'XC-000I-000I-101L-130L',
/
&electrons
    conv_thr = 1.0e-8,
/
ATOMIC_SPECIES
  Ni  58.6934  Ni.upf

ATOMIC_POSITIONS crystal
  Ni  0.000  0.000  0.000

K_POINTS crystal_b
6
  0.000  0.000  0.000  30  ! G
  0.500  0.000  0.500  30  ! X
  0.500  0.250  0.750  30  ! W
  0.375  0.375  0.750  30  ! K
  0.000  0.000  0.000  30  ! G
  0.500  0.500  0.500  1   ! L
