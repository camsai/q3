&CONTROL
  calculation = 'scf'
  pseudo_dir = '../../../data/pseudopotentials/us/'
  outdir = './tmp'
  prefix = 'qe_us_hubbard'
/
&SYSTEM
  ibrav = 2
  celldm(1) = 10.334401769190510
  nat = 2
  ntyp = 1
  ecutwfc = 30.0
  ecutrho = 200.0
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.005
  input_dft = 'XC-000I-000I-101L-130L'
/
&ELECTRONS
  conv_thr = 1.0e-10
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  Si 28.085 Si_PBE_USPP.UPF
ATOMIC_POSITIONS crystal
  Si 0.00 0.00 0.00
  Si 0.25 0.25 0.25
K_POINTS automatic
  4 4 4 0 0 0
HUBBARD (atomic)
U Si-3p 3.0
