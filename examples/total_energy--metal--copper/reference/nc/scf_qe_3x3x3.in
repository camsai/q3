&CONTROL
    calculation = 'scf'
    prefix = 'cu_333_nc'
    pseudo_dir = '../../../data/pseudopotentials/nc/'
    outdir = './tmp'
    tprnfor = .true.
    tstress = .true.
    verbosity = 'high'
/

&SYSTEM
    ibrav = 2
    celldm(1) = 20.52959
    nat = 27
    ntyp = 1
    ecutwfc = 120.0
    ecutrho = 480.0
    occupations = 'smearing'
    smearing = 'gaussian'
    degauss = 0.02
    nbnd = 280
    input_dft = 'XC-000I-000I-101L-130L'
/

&ELECTRONS
    conv_thr = 1.0d-8
    mixing_beta = 0.2
    mixing_mode = 'plain'
    electron_maxstep = 200
/

ATOMIC_SPECIES
  Cu  63.546  Cu.upf

