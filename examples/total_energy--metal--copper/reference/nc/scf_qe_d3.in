&CONTROL
  calculation = 'scf'
  pseudo_dir = '../../../data/pseudopotentials/nc/'
  outdir = './tmp'
  prefix = 'qe_nc_d3'
  verbosity = 'high'
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 2
  celldm(1) = 6.843194
  nat = 1
  ntyp = 1
  ecutwfc = 120.0
  input_dft = 'pbe'
  ecutrho = 480.0
  occupations = 'smearing'
  smearing = 'gauss'
  degauss = 0.02
  vdw_corr = 'dft-d3'
  dftd3_version = 4
  dftd3_threebody = .false.
/
&ELECTRONS
  conv_thr = 1.0e-8
  mixing_beta = 0.3
  electron_maxstep = 500
/
ATOMIC_SPECIES
  Cu 63.546 Cu.upf
ATOMIC_POSITIONS crystal
  Cu 0.000000 0.000000 0.000000
K_POINTS automatic
  4 4 4 1 1 1
