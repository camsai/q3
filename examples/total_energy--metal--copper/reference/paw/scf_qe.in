&CONTROL
  calculation = 'scf'
  pseudo_dir = '../../../data/pseudopotentials/paw/'
  outdir = './tmp'
  prefix = 'qe_paw'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 2
  celldm(1) = 6.843193628257024
  nat = 1
  ntyp = 1
  ecutwfc = 40.0
  ecutrho = 320.0
  nbnd = 20
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.02
  input_dft = 'XC-000I-000I-101L-130L'
/
&ELECTRONS
  diagonalization = 'cg'
  conv_thr = 1.0e-12
  mixing_beta = 0.1
/
ATOMIC_SPECIES
  Cu 63.546 Cu.upf
ATOMIC_POSITIONS crystal
  Cu 0.000000 0.000000 0.000000
K_POINTS automatic
  4 4 4 1 1 1
