&control
    calculation = 'bands',
    outdir = './qe_output',
    prefix = 'cu_scf',
    pseudo_dir = '.',
/
&system
    ibrav = 2,
    celldm(1) = 6.8413,
    nat = 1,
    ntyp = 1,
    ecutwfc = 120.0,
    ecutrho = 480.0,
    nbnd = 20,
    occupations = 'smearing',
    smearing = 'gaussian',
    degauss = 0.02,
    input_dft = 'XC-000I-000I-101L-130L',
/
&electrons
    conv_thr = 1.0e-8,
/
ATOMIC_SPECIES
  Cu  63.546  Cu.upf

ATOMIC_POSITIONS crystal
  Cu  0.000  0.000  0.000

K_POINTS crystal_b
10
  0.000  0.000  0.000  30  ! G
  0.500  0.000  0.500  30  ! X
  0.500  0.250  0.750  30  ! W
  0.375  0.375  0.750  30  ! K
  0.000  0.000  0.000  30  ! G
  0.500  0.500  0.500  30  ! L
  0.625  0.250  0.625  30  ! U
  0.500  0.250  0.750  30  ! W
  0.500  0.500  0.500  30  ! L
  0.375  0.375  0.750  1   ! K
