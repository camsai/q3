# Write the build-identity header, re-evaluated on every build.
#
# Run as a script (cmake -P) from a custom target rather than at configure time,
# because a configure-time value is captured once and then goes stale: every
# commit made after the first `cmake` would be reported under its predecessor's
# SHA, and a results file that confidently names the wrong source is worse than
# one that admits it does not know.
#
# Expects Q3_SOURCE_DIR, Q3_OUTPUT_FILE, and optionally Q3_GIT_COMMIT_OVERRIDE
# (used by release and container builds, which have no .git to consult).

set(commit "${Q3_GIT_COMMIT_OVERRIDE}")

if(commit STREQUAL "")
    find_package(Git QUIET)
    if(GIT_FOUND AND EXISTS "${Q3_SOURCE_DIR}/.git")
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
            WORKING_DIRECTORY "${Q3_SOURCE_DIR}"
            OUTPUT_VARIABLE commit
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
            RESULT_VARIABLE git_status)
        if(NOT git_status EQUAL 0)
            set(commit "")
        endif()
    endif()
endif()

# A worktree with modified tracked files is not the commit it sits on, and
# naming that commit would be the same lie in a subtler form. Report nothing
# rather than something adjacent.
#
# Untracked files are deliberately not counted (--untracked-files=no). Every
# working checkout has some -- a virtual environment, a build directory, scratch
# output -- and counting them would report an empty commit from every developer
# build, which trains readers to ignore the field. The residual risk is an
# untracked header shadowing a tracked one; that is rarer than untracked scratch
# by a wide margin, and it is the trade this line is making knowingly.
if(NOT commit STREQUAL "" AND GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
        WORKING_DIRECTORY "${Q3_SOURCE_DIR}"
        OUTPUT_VARIABLE worktree_changes
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(NOT worktree_changes STREQUAL "")
        set(commit "")
    endif()
endif()

set(contents "#pragma once\n// Generated by cmake/write_git_commit_header.cmake. Do not edit.\n")
if(NOT commit STREQUAL "")
    string(APPEND contents "#define Q3_GIT_COMMIT \"${commit}\"\n")
endif()

# Only rewrite when the value actually changed, so an unchanged commit does not
# force a rebuild of everything that includes it.
set(previous "")
if(EXISTS "${Q3_OUTPUT_FILE}")
    file(READ "${Q3_OUTPUT_FILE}" previous)
endif()
if(NOT previous STREQUAL contents)
    file(WRITE "${Q3_OUTPUT_FILE}" "${contents}")
endif()
