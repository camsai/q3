# Doxyfile — Q3 DFT Engine API Documentation
# Generated docs are deployed to GitHub Pages via CI.

# --- Project ---
PROJECT_NAME           = "Q3 DFT Engine"
PROJECT_BRIEF          = "A modern, from-scratch plane-wave DFT engine in C++17"
PROJECT_NUMBER         = ""
OUTPUT_DIRECTORY       = docs_build

# --- Input ---
INPUT                  = src docs/architecture.md docs/ontology.md README.md SUMMARY.md FUNCTIONALITY.md
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
EXCLUDE_PATTERNS       = */generated/* */.venv/* */build/*

# --- Extraction ---
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

# --- Source browsing ---
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# --- Diagrams ---
HAVE_DOT               = NO

CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO

# --- HTML output ---
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome-css/doxygen-awesome.css \
                         docs/doxygen-awesome-css/doxygen-awesome-sidebar-only.css
HTML_EXTRA_FILES       =
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_SECTIONS  = YES
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# --- Other output formats (disabled) ---
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

# --- Preprocessing ---
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO

# --- Warnings ---
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# --- Sorting ---
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = YES
